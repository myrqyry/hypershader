// Scalar metadata defaults must survive subsequent source updates.
#include "../../stdlib/hypershader_standard.glsl"
// @default 0.75 @label "Test Gain"
uniform float gain;
void hs_shade_pixel(out vec4 fragColor, in vec2 fragCoord) {
    fragColor = vec4(gain, gain, gain, 1.0);
}
HYPERSHADER_PIXEL_WRAPPER
