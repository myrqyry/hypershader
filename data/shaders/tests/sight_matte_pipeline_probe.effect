// @label "Sight Matte Interop Probe"
uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d hs_segmentation;
uniform float hs_sight_matte_present;
uniform float hs_sight_subject_present;
uniform float4 hs_sight_subject_bounds;
uniform float2 hs_sight_subject_center;
uniform float hs_sight_subject_coverage;
sampler_state sourceSampler { Filter=Linear; AddressU=Clamp; AddressV=Clamp; };
struct VertData { float4 pos:POSITION; float2 uv:TEXCOORD0; };
VertData VSDefault(VertData v) {
    VertData o; o.pos=mul(float4(v.pos.xyz,1),ViewProj); o.uv=v.uv; return o;
}
float4 PSMain(VertData v):TARGET {
    if (hs_sight_matte_present<0.5) {
        // A stale subject uniform must not survive invalidation.
        if (hs_sight_subject_present>0.5 || dot(abs(hs_sight_subject_bounds),float4(1,1,1,1))>0 ||
            dot(abs(hs_sight_subject_center),float2(1,1))>0 || hs_sight_subject_coverage>0)
            return float4(0,1,0,1);
        return image.Sample(sourceSampler,v.uv);
    }
    // Encode each geometry component independently in a small top strip.
    if (v.uv.y<0.04) {
        float value=0;
        if (v.uv.x<0.125) value=hs_sight_subject_bounds.x;
        else if (v.uv.x<0.25) value=hs_sight_subject_bounds.y;
        else if (v.uv.x<0.375) value=hs_sight_subject_bounds.z;
        else if (v.uv.x<0.5) value=hs_sight_subject_bounds.w;
        else if (v.uv.x<0.625) value=hs_sight_subject_center.x;
        else if (v.uv.x<0.75) value=hs_sight_subject_center.y;
        else if (v.uv.x<0.875) value=hs_sight_subject_coverage;
        else value=hs_sight_subject_present;
        return float4(value,1,0,1);
    }
    return float4(hs_segmentation.Sample(sourceSampler,v.uv).r,0,1,1);
}
technique Draw { pass { vertex_shader=VSDefault(v); pixel_shader=PSMain(v); } }
