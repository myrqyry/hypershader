// Opt-in sizes and floating point data buffers.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d iBufferA;
uniform texture2d iBufferB;
uniform texture2d iBufferAPrevious;
uniform texture2d iBufferBPrevious;
uniform int iBufferADivisor = 2;
uniform int iBufferBDivisor = 4;
uniform int iBufferAFormat = 1;
uniform int iBufferBFormat = 1;
uniform float3 iResolution;
uniform float3 iBufferAResolution;
uniform float3 iBufferBResolution;
uniform float3 iGraphOutputResolution;
uniform int iGraphFrame;
uniform float output_gain; // @min 0.0 @max 1.0 @step 0.01 @default 1.0 @label "Output Gain"
sampler_state simSampler { Filter=Linear; AddressU=Clamp; AddressV=Clamp; };
struct VertData { float4 pos:POSITION; float2 uv:TEXCOORD0; };
VertData VSDefault(VertData v) {
 VertData o; o.pos=mul(float4(v.pos.xyz,1.0),ViewProj);o.uv=v.uv;return o;
}
float4 PSA(VertData v):TARGET {
 float value=iBufferAPrevious.Sample(simSampler,v.uv).r;
 float inputLevel=image.Sample(simSampler,v.uv).r;
 float2 expected=ceil(iGraphOutputResolution.xy / 2.0);
 bool good=length(iResolution.xy-expected)<0.01 && length(iBufferAResolution.xy-expected)<0.01;
 if(iGraphFrame>0) {
  float4 prev=iBufferAPrevious.Sample(simSampler,v.uv);
  good=good && abs(prev.b+0.5)<0.01 && abs(prev.a-1.5)<0.01;
 } else {
  float4 seed=iBufferAPrevious.Load(int3(int2(iBufferAResolution.xy)-int2(1,1),0));
  good=good && length(seed.rgb)<0.01 && abs(seed.a-1.0)<0.01;
 }
 return float4(min(value+0.008+inputLevel*0.01,0.85),v.uv.x,good?-0.5:0.5,1.5);
}
float4 PSB(VertData v):TARGET {
 float4 a=iBufferA.Sample(simSampler,v.uv);
 float history=iBufferBPrevious.Sample(simSampler,v.uv).g;
 float2 expected=ceil(iGraphOutputResolution.xy / 4.0);
 // Exact last texel must be rendered at the reduced size.
 int2 last=int2(iBufferAResolution.xy)-int2(1,1);
 float4 edge=iBufferA.Load(int3(last,0));
 bool good=length(iResolution.xy-expected)<0.01 && length(iBufferBResolution.xy-expected)<0.01
   && abs(a.b+0.5)<0.01 && abs(a.a-1.5)<0.01 && edge.g>0.98;
 if(iGraphFrame>0) {
  float4 prev=iBufferBPrevious.Sample(simSampler,v.uv);
  good=good && abs(prev.b+0.75)<0.01 && abs(prev.a-1.75)<0.01;
 } else {
  float4 seed=iBufferBPrevious.Load(int3(int2(iBufferBResolution.xy)-int2(1,1),0));
  good=good && length(seed.rgb)<0.01 && abs(seed.a-1.0)<0.01;
 }
 return float4(v.uv.x,min(history+0.006+a.r*0.008,0.7),good?-0.75:0.75,1.75);
}
float4 PSFinal(VertData v):TARGET {
 float4 a=iBufferA.Sample(simSampler,v.uv);
 float4 b=iBufferB.Sample(simSampler,v.uv);
 float4 edge=iBufferB.Load(int3(int2(iBufferBResolution.xy)-int2(1,1),0));
 bool good=edge.r>0.98 && length(iResolution.xy-iGraphOutputResolution.xy)<0.01
  && length(iBufferAResolution.xy-ceil(iResolution.xy/2.0))<0.01
  && length(iBufferBResolution.xy-ceil(iResolution.xy/4.0))<0.01
  && abs(a.b+0.5)<0.01 && abs(a.a-1.5)<0.01 && abs(b.b+0.75)<0.01 && abs(b.a-1.75)<0.01;
 if(iGraphFrame>0) {
  float4 prevA=iBufferAPrevious.Sample(simSampler,v.uv);
  float4 prevB=iBufferBPrevious.Sample(simSampler,v.uv);
  good=good && abs(prevA.b+0.5)<0.01 && abs(prevB.b+0.75)<0.01;
 }
 return float4(a.r*output_gain,b.g*output_gain,good?0.0:1.0,1);
}
technique BufferA { pass {vertex_shader=VSDefault(v);pixel_shader=PSA(v);} }
technique BufferB { pass {vertex_shader=VSDefault(v);pixel_shader=PSB(v);} }
technique Draw { pass {vertex_shader=VSDefault(v);pixel_shader=PSFinal(v);} }
