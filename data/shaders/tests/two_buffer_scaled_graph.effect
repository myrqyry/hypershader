// Opt-in sizes and floating point data buffers.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d hs_buffer_a;
uniform texture2d hs_buffer_b;
uniform texture2d hs_buffer_a_previous;
uniform texture2d hs_buffer_b_previous;
uniform int hs_buffer_a_divisor = 2;
uniform int hs_buffer_b_divisor = 4;
uniform int hs_buffer_a_format = 1;
uniform int hs_buffer_b_format = 1;
uniform float3 hs_resolution;
uniform float3 hs_buffer_a_resolution;
uniform float3 hs_buffer_b_resolution;
uniform float3 hs_graph_output_resolution;
uniform int hs_graph_frame;
uniform float output_gain; // @min 0.0 @max 1.0 @step 0.01 @default 1.0 @label "Output Gain"
sampler_state simSampler { Filter=Linear; AddressU=Clamp; AddressV=Clamp; };
struct VertData { float4 pos:POSITION; float2 uv:TEXCOORD0; };
VertData VSDefault(VertData v) {
 VertData o; o.pos=mul(float4(v.pos.xyz,1.0),ViewProj);o.uv=v.uv;return o;
}
float4 PSA(VertData v):TARGET {
 float value=hs_buffer_a_previous.Sample(simSampler,v.uv).r;
 float inputLevel=image.Sample(simSampler,v.uv).r;
 float2 expected=ceil(hs_graph_output_resolution.xy / 2.0);
 bool good=length(hs_resolution.xy-expected)<0.01 && length(hs_buffer_a_resolution.xy-expected)<0.01;
 if(hs_graph_frame>0) {
  float4 prev=hs_buffer_a_previous.Sample(simSampler,v.uv);
  good=good && abs(prev.b+0.5)<0.01 && abs(prev.a-1.5)<0.01;
 } else {
  float4 seed=hs_buffer_a_previous.Load(int3(int2(hs_buffer_a_resolution.xy)-int2(1,1),0));
  good=good && length(seed.rgb)<0.01 && abs(seed.a-1.0)<0.01;
 }
 return float4(min(value+0.008+inputLevel*0.01,0.85),v.uv.x,good?-0.5:0.5,1.5);
}
float4 PSB(VertData v):TARGET {
 float4 a=hs_buffer_a.Sample(simSampler,v.uv);
 float history=hs_buffer_b_previous.Sample(simSampler,v.uv).g;
 float2 expected=ceil(hs_graph_output_resolution.xy / 4.0);
 // Exact last texel must be rendered at the reduced size.
 int2 last=int2(hs_buffer_a_resolution.xy)-int2(1,1);
 float4 edge=hs_buffer_a.Load(int3(last,0));
 bool good=length(hs_resolution.xy-expected)<0.01 && length(hs_buffer_b_resolution.xy-expected)<0.01
   && abs(a.b+0.5)<0.01 && abs(a.a-1.5)<0.01 && edge.g>0.98;
 if(hs_graph_frame>0) {
  float4 prev=hs_buffer_b_previous.Sample(simSampler,v.uv);
  good=good && abs(prev.b+0.75)<0.01 && abs(prev.a-1.75)<0.01;
 } else {
  float4 seed=hs_buffer_b_previous.Load(int3(int2(hs_buffer_b_resolution.xy)-int2(1,1),0));
  good=good && length(seed.rgb)<0.01 && abs(seed.a-1.0)<0.01;
 }
 return float4(v.uv.x,min(history+0.006+a.r*0.008,0.7),good?-0.75:0.75,1.75);
}
float4 PSFinal(VertData v):TARGET {
 float4 a=hs_buffer_a.Sample(simSampler,v.uv);
 float4 b=hs_buffer_b.Sample(simSampler,v.uv);
 float4 edge=hs_buffer_b.Load(int3(int2(hs_buffer_b_resolution.xy)-int2(1,1),0));
 bool good=edge.r>0.98 && length(hs_resolution.xy-hs_graph_output_resolution.xy)<0.01
  && length(hs_buffer_a_resolution.xy-ceil(hs_resolution.xy/2.0))<0.01
  && length(hs_buffer_b_resolution.xy-ceil(hs_resolution.xy/4.0))<0.01
  && abs(a.b+0.5)<0.01 && abs(a.a-1.5)<0.01 && abs(b.b+0.75)<0.01 && abs(b.a-1.75)<0.01;
 if(hs_graph_frame>0) {
  float4 prevA=hs_buffer_a_previous.Sample(simSampler,v.uv);
  float4 prevB=hs_buffer_b_previous.Sample(simSampler,v.uv);
  good=good && abs(prevA.b+0.5)<0.01 && abs(prevB.b+0.75)<0.01;
 }
 return float4(a.r*output_gain,b.g*output_gain,good?0.0:1.0,1);
}
technique BufferA { pass {vertex_shader=VSDefault(v);pixel_shader=PSA(v);} }
technique BufferB { pass {vertex_shader=VSDefault(v);pixel_shader=PSB(v);} }
technique Draw { pass {vertex_shader=VSDefault(v);pixel_shader=PSFinal(v);} }
