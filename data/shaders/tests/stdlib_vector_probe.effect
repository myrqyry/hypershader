// Actual metadata-to-OBS settings regression for non-scalar defaults.
#include "../../stdlib/hypershader_standard.glsl"
// @default "0.8,0.2,0.4" @label "Test Palette"
uniform float3 tint;
void hs_shade_pixel(out vec4 fragColor, in vec2 fragCoord) {
    fragColor = vec4(tint, 1.0);
}
HYPERSHADER_PIXEL_WRAPPER
