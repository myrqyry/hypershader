// Native HyperShader import exercise for Karis-weighted bloom disabled bypass.
// This must compile and render through the actual OBS HyperShader loader.
#include "../../stdlib/hypershader_standard.glsl"
#include "../../stdlib/postprocess_3d.glsl"

void hs_shade_pixel(out float4 fragColor, in float2 fragCoord)
{
    float2 uv = fragCoord / max(hs_resolution.xy, float2(1.0, 1.0));
    float4 src = image.Sample(textureSampler, uv);
    float3 combined = applyBloom(uv, max(hs_resolution.xy, float2(1.0, 1.0)),
                                  0.0, 0.55, 0.15);
    fragColor = float4(saturate(combined), src.a);
}
HYPERSHADER_PIXEL_WRAPPER
