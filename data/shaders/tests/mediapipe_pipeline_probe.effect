// @mediapipe @mediapipe_modes
// @label "MediaPipe GPU Pipeline Probe"
// Test-only: exact libobs upload of the normalized nose landmark.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d iLandmarks;
uniform float3 iResolution;
struct VertData { float4 pos: POSITION; float2 uv:TEXCOORD0; };
VertData VSDefault(VertData v){VertData outV;outV.pos=mul(float4(v.pos.xyz,1),ViewProj);outV.uv=v.uv;return outV;}
float4 PSMain(VertData v):TARGET {
    float4 nose = iLandmarks.Load(int3(1,0,0));
    return float4(nose.x, nose.y, 0.0, 1.0);
}
technique Draw { pass { vertex_shader=VSDefault(v); pixel_shader=PSMain(v); } }
