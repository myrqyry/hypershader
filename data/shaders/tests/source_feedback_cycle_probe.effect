// Standalone OBS source feedback must render after history texture reuse.
#include "../../stdlib/hypershader_standard.glsl"
uniform texture2d hs_history;
void hs_shade_pixel(out vec4 fragColor, in vec2 fragCoord) {
    vec2 uv = fragCoord / hs_resolution.xy;
    vec4 oldColor = hs_history.Sample(textureSampler, uv);
    float pulse = frac(hs_time * 0.4);
    fragColor = vec4(pulse * 0.8 + oldColor.r * 0.02, 0.2, 0.6, 1.0);
}
HYPERSHADER_PIXEL_WRAPPER
