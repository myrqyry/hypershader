uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d hs_segmentation;
uniform float hs_sight_matte_present;
uniform texture2d hs_sight_flow;
uniform float hs_sight_flow_present;
uniform float hs_sight_flow_coverage;
sampler_state pointSampler {Filter=Point;AddressU=Clamp;AddressV=Clamp;};
struct VertData {float4 pos:POSITION;float2 uv:TEXCOORD0;};
VertData VSDefault(VertData v){VertData o;o.pos=mul(float4(v.pos.xyz,1),ViewProj);o.uv=v.uv;return o;}
float4 PSMain(VertData v):TARGET {
    // Header encodes per-signal availability; remaining rows verify actual textures.
    if(v.uv.y<0.04)return float4(hs_sight_matte_present,hs_sight_flow_present,hs_sight_flow_coverage,1);
    float matte=0,confidence=0;
    if(hs_sight_matte_present>0.5)matte=hs_segmentation.Sample(pointSampler,v.uv).r;
    if(hs_sight_flow_present>0.5)confidence=hs_sight_flow.Sample(pointSampler,v.uv).b;
    return float4(matte,confidence,1,1);
}
technique Draw {pass {vertex_shader=VSDefault(v);pixel_shader=PSMain(v);}}
