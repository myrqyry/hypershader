// Regression fixture: native metadata spring must reach final Draw.
uniform float4x4 ViewProj;
uniform float mapped_spring; // @audio "peak" @gain 4 @dynamics "spring" freq=2 damp=0.7
struct VertData { float4 pos:POSITION; float2 uv:TEXCOORD0; };
VertData VSDefault(VertData v) { VertData o; o.pos=mul(float4(v.pos.xyz,1),ViewProj); o.uv=v.uv; return o; }
float4 PSMain(VertData v):TARGET {
    float x=smoothstep(0.025,0.075,mapped_spring);
    return float4(1.0-x,x,0,1);
}
technique Draw { pass { vertex_shader=VSDefault(v); pixel_shader=PSMain(v); } }
