uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d hs_sight_depth;
uniform float hs_sight_depth_present;
uniform texture2d hs_segmentation;
uniform float hs_sight_matte_present;
uniform texture2d hs_sight_flow;
uniform float hs_sight_flow_present;
sampler_state pointSampler {Filter=Point;AddressU=Clamp;AddressV=Clamp;};
struct VertData {float4 pos:POSITION;float2 uv:TEXCOORD0;};
VertData VSDefault(VertData v){VertData o;o.pos=mul(float4(v.pos.xyz,1),ViewProj);o.uv=v.uv;return o;}
float4 PSMain(VertData v):TARGET {
    if(v.uv.y<0.04)return float4(hs_sight_depth_present,hs_sight_matte_present,hs_sight_flow_present,1);
    float d=0,m=0,f=0;
    if(hs_sight_depth_present>0.5)d=hs_sight_depth.Sample(pointSampler,v.uv).r;
    if(hs_sight_matte_present>0.5)m=hs_segmentation.Sample(pointSampler,v.uv).r;
    if(hs_sight_flow_present>0.5)f=hs_sight_flow.Sample(pointSampler,v.uv).b;
    return float4(d,m,f,1);
}
technique Draw {pass {vertex_shader=VSDefault(v);pixel_shader=PSMain(v);}}
