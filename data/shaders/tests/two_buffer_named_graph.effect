// Named input and numbered slot share the existing resource lifecycle.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d normalMap; // @input 0 @label "Normal Map"
uniform texture2d roughnessMap; // @input 2 @label "Roughness Map"
uniform float4 roughnessMap_resolution;
uniform float4 normalMap_resolution;
uniform float normalMap_time;
uniform texture2d hs_buffer_a;
uniform texture2d hs_buffer_b;
uniform texture2d hs_buffer_a_previous;
uniform texture2d hs_buffer_b_previous;
uniform int hs_buffer_a_divisor = 2;
uniform int hs_buffer_b_divisor = 4;
sampler_state simSampler { Filter=Point; AddressU=Clamp; AddressV=Clamp; };
struct VertData { float4 pos:POSITION; float2 uv:TEXCOORD0; };
VertData VSDefault(VertData v) {
 VertData o; o.pos=mul(float4(v.pos.xyz,1.0),ViewProj);o.uv=v.uv;return o;
}
float channelStatus(float2 uv) {
 float4 c=normalMap.Sample(simSampler,uv);
 float4 rough=roughnessMap.Sample(simSampler,uv);
 if(length(roughnessMap_resolution.xy-float2(3.0,2.0))>0.01 || length(rough.rgb-float3(0.25,0.5,0.75))>0.04) return 0.0;
 if(length(normalMap_resolution.xy-float2(3.0,2.0))<0.01 &&
    length(c.rgb-float3(0.25,0.5,0.75))<0.04 && normalMap_time>0.0)
  return 1.0;
 if(length(normalMap_resolution.xy)<0.01 && length(c.rgb)<0.01)
  return 0.25;
 return 0.0;
}
float4 PSA(VertData v):TARGET {
 return float4(channelStatus(v.uv),0,0,1);
}
float4 PSB(VertData v):TARGET {
 return float4(hs_buffer_a.Sample(simSampler,v.uv).r,channelStatus(v.uv),0,1);
}
float4 PSFinal(VertData v):TARGET {
 float2 ab=hs_buffer_b.Sample(simSampler,v.uv).rg;
 return float4(ab,channelStatus(v.uv),1);
}
technique BufferA { pass {vertex_shader=VSDefault(v);pixel_shader=PSA(v);} }
technique BufferB { pass {vertex_shader=VSDefault(v);pixel_shader=PSB(v);} }
technique Draw { pass {vertex_shader=VSDefault(v);pixel_shader=PSFinal(v);} }
