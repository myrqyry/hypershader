// @label "Face Mesh Wireframe"
// @mediapipe @mediapipe_modes
// Native MediaPipe face topology over the real video source.
// Requires a Face Mesh graph with ONNX face models; hand, pose and depth are not implied.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d iFaceSurface;
uniform texture2d iFaceTriangles;
uniform float iFacePresent;
uniform float thickness; // @min 0.001 @max 0.1 @step 0.001 @default 0.02 @label "Wire Thickness" @group "Face Mesh"
uniform float strength; // @min 0 @max 1 @step 0.01 @default 0.85 @label "Overlay Strength" @group "Face Mesh"
uniform float4 wireColor; // @default "0.0,0.9,0.9,1.0" @label "Wire Color" @group "Face Mesh"
uniform sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};
struct VertData {float4 pos:POSITION;float2 uv:TEXCOORD0;};
VertData VSDefault(VertData v){VertData o;o.pos=mul(float4(v.pos.xyz,1),ViewProj);o.uv=v.uv;return o;}
float4 PSMain(VertData v):TARGET {
    float4 original=image.Sample(textureSampler,v.uv);
    if (iFacePresent < 0.5) return original;
    float4 face=iFaceSurface.Load(int3(int2(v.uv*256.0),0));
    if (face.a<0.5) return original;
    float edge=min(min(face.g,face.b),1.0-face.g-face.b);
    float amount=(1.0-smoothstep(0.0,max(thickness,0.001),edge)) * saturate(strength);
    return float4(lerp(original.rgb, wireColor.rgb,amount), original.a);
}
technique Draw { pass {vertex_shader=VSDefault(v);pixel_shader=PSMain(v);} }
