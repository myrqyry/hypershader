// @label "Contact Filaments"
// @description "Sight hand joints form delicate copper threads and pearl endpoints. Gestures and pinch vary the filaments. No tracked hand means exact pass-through."
// Original first-party hypershader artwork. Requires LLL.sight Tracking in hands mode, same source/framing.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d hs_sight_hands;
uniform float hs_sight_present;
uniform int hs_sight_hand_count;
uniform float hs_sight_pinch0;
uniform float hs_sight_pinch1;
uniform float audio_envelope;
uniform float3 hs_resolution;
uniform float thread_width; // @min 0.6 @max 7 @step 0.2 @default 2.0 @label "Thread Width (px)" @group "Geometry"
uniform float node_radius; // @min 2 @max 24 @step 1 @default 7 @label "Pearl Radius (px)" @group "Geometry"
uniform float audio_sway; // @min 0 @max 2 @step 0.05 @default 0.7 @label "Audio Shimmer" @group "Motion"
uniform float opacity; // @min 0 @max 1 @step 0.01 @default 0.90 @label "Opacity" @group "Appearance"
uniform float3 thread_color; // @default "0.76,0.44,0.30" @label "Copper Thread" @group "Palette"
uniform float3 node_color; // @default "0.96,0.91,0.81" @label "Pearl" @group "Palette"
sampler_state threadSampler {Filter=Linear;AddressU=Clamp;AddressV=Clamp;};
struct VertData{float4 pos:POSITION;float2 uv:TEXCOORD0;};
VertData VSDefault(VertData v){
    VertData o;o.pos=mul(float4(v.pos.xyz,1),ViewProj);o.uv=v.uv;return o;
}
float segmentDistance(float2 p,float2 a,float2 b){
    float2 ab=b-a;
    float t=saturate(dot(p-a,ab)/max(dot(ab,ab),0.000001));
    return length(p-a-ab*t);
}
float4 PSMain(VertData v):TARGET{
    float4 src=image.Sample(threadSampler,v.uv);
    if(hs_sight_present<0.5||hs_sight_hand_count<1||opacity<=0.0||src.a<=0.0001)return src;
    float2 size=max(hs_resolution.xy,float2(1,1));
    float2 p=v.uv*size;
    float line=0.0,pearl=0.0;
    for(int h=0;h<2;h++){
        if(h>=hs_sight_hand_count)break;
        float2 wrist=hs_sight_hands.Load(int3(0,h,0)).xy*size;
        float2 thumb=hs_sight_hands.Load(int3(4,h,0)).xy*size;
        float2 index=hs_sight_hands.Load(int3(8,h,0)).xy*size;
        float2 middle=hs_sight_hands.Load(int3(12,h,0)).xy*size;
        float2 ring=hs_sight_hands.Load(int3(16,h,0)).xy*size;
        float2 little=hs_sight_hands.Load(int3(20,h,0)).xy*size;
        float pinch=h==0?hs_sight_pinch0:hs_sight_pinch1;
        float extra=1.0+0.45*saturate(pinch)+0.20*saturate(audio_envelope)*audio_sway;
        float w=max(0.3,thread_width)*extra;
        float d=segmentDistance(p,wrist,thumb);
        d=min(d,segmentDistance(p,thumb,index));
        d=min(d,segmentDistance(p,index,middle));
        d=min(d,segmentDistance(p,middle,ring));
        d=min(d,segmentDistance(p,ring,little));
        d=min(d,segmentDistance(p,little,wrist));
        line=max(line,1.0-smoothstep(w,w+1.6,d));
        float node=length(p-index);
        node=min(node,length(p-thumb));
        node=min(node,length(p-middle));
        pearl=max(pearl,1.0-smoothstep(node_radius,node_radius+2.0,node));
    }
    float3 ink=src.rgb+thread_color*line*0.56+node_color*pearl*0.72;
    return float4(lerp(src.rgb,saturate(ink),saturate(opacity)),src.a);
}
technique Draw{pass{vertex_shader=VSDefault(v);pixel_shader=PSMain(v);}}
