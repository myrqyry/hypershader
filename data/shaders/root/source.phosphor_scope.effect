// @label "Phosphor Oscilloscope"
// @description "Native transparent oscilloscope driven by captured PCM samples (channel 0, audio texture row 1)."
// Original HyperShaderFX artwork: no imported shaders or additional processing runtime.
#include "../../stdlib/hypershader_standard.glsl"

uniform float trace_gain;   // @min 0.1 @max 8.0 @step 0.1 @default 2.0 @label "Waveform Gain" @group "Response"
uniform float trace_height; // @min 0.02 @max 0.48 @step 0.01 @default 0.32 @label "Vertical Reach" @group "Response"
uniform float time_zoom;    // @min 1.0 @max 8.0 @step 0.1 @default 1.0 @label "Horizontal Zoom" @group "Response"
uniform float line_width;   // @min 0.5 @max 6.0 @step 0.1 @default 2.2 @label "Trace Width (px)" @group "Appearance"
uniform float glow;         // @min 0.0 @max 1.0 @step 0.02 @default 0.35 @label "Phosphor Glow" @group "Appearance"
uniform float opacity;      // @min 0.0 @max 1.0 @step 0.02 @default 1.0 @label "Opacity" @group "Appearance"
uniform float grid_opacity; // @min 0.0 @max 0.5 @step 0.01 @default 0.0 @label "Scope Graticule" @group "Appearance"
uniform float3 trace_color; // @default "0.57,0.81,0.64" @label "Phosphor Color" @group "Appearance"

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    float2 size = max(iResolution.xy, float2(1.0, 1.0));
    float2 uv = fragCoord / size;

    // 512 source samples cover the most recent FFT window. Row 1 is real
    // PCM encoded from [-1,+1] to [0,255]. Zoom selects a narrower interval.
    // No generated waveform or sine oscillator is used for display.
    float audioX = clamp(0.5 + (uv.x - 0.5) / max(time_zoom, 1.0), 0.002, 0.998);
    float sampleR8 = iChannel0.Sample(textureSampler, float2(audioX, 0.75)).r;
    float amplitude = (sampleR8 - 0.5) * 2.0;
    float lineY = 0.5 + clamp(amplitude * trace_height * trace_gain, -0.48, 0.48);

    float distancePixels = abs(uv.y - lineY) * size.y;
    float core = 1.0 - smoothstep(line_width * 0.45, line_width + 1.0, distancePixels);
    float bloom = exp(-distancePixels / max(1.0, line_width * 3.4)) * glow * 0.35;
    float a = saturate(max(core, bloom) * opacity);

    // Optional 10x6 division graticule, off by default for overlay use.
    // Convert phase back to actual pixels so grid lines remain hairline thin.
    float dx = abs(frac(uv.x * 10.0 + 0.5) - 0.5) * size.x / 10.0;
    float dy = abs(frac(uv.y * 6.0 + 0.5) - 0.5) * size.y / 6.0;
    float graticule = 1.0 - smoothstep(0.35, 1.25, min(dx, dy));
    float gridA = graticule * grid_opacity * 0.5 * opacity;

    // Dimmer graticule pigment but correct premultiplied alpha for OBS.
    float outA = saturate(a + gridA * (1.0 - a));
    float3 rgb = trace_color * (a + gridA * 0.36 * (1.0 - a));
    fragColor = float4(rgb, outA);
}
HYPERSHADER_MAINIMAGE_WRAPPER
