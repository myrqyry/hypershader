// @label "Sight: Flow Echo"
// @description "Advect decaying bright history with Sight's measured local motion, once per new capture. Requires Spatial Motion above this filter."
uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d iBufferA;
uniform texture2d iBufferB;
uniform texture2d iBufferAPrevious;
uniform texture2d iBufferBPrevious;
uniform texture2d iSightFlow;
uniform float iSightFlowPresent;
uniform float iSightFlowStep;
uniform int iGraphFrame;
uniform float iTimeDelta;
uniform float retention; // @label "Trail Half-Life (seconds)" @min 0.05 @max 5 @step 0.05 @default 0.65 @group "Trail"
uniform float tracking; // @label "Flow Tracking" @min 0 @max 2 @step 0.05 @default 0.85 @group "Trail"
uniform float effect_mix; // @label "Effect Mix" @min 0 @max 1 @step 0.01 @default 0.9 @group "Output"
uniform bool clear_history; // @label "Clear Trails" @default false @group "Output"
sampler_state videoSampler {Filter=Linear;AddressU=Clamp;AddressV=Clamp;};
sampler_state flowSampler {Filter=Linear;AddressU=Clamp;AddressV=Clamp;};
struct VertData {float4 pos:POSITION;float2 uv:TEXCOORD0;};
VertData VSDefault(VertData v) {
    VertData o;o.pos=mul(float4(v.pos.xyz,1),ViewProj);o.uv=v.uv;return o;
}
float4 PSStore(VertData v):TARGET {
    return image.Sample(videoSampler,v.uv);
}
float4 PSEcho(VertData v):TARGET {
    float4 fresh=iBufferA.Sample(videoSampler,v.uv);
    if(iGraphFrame==0||iSightFlowPresent<0.5||clear_history||effect_mix<=0.0001)return fresh;
    float2 from=v.uv;
    if(iSightFlowStep>0.5){
        float4 motion=iSightFlow.Sample(flowSampler,v.uv);
        from+=motion.xy*saturate(motion.b)*tracking;
    }
    if(from.x<0.0||from.y<0.0||from.x>1.0||from.y>1.0)return fresh;
    float4 history=iBufferBPrevious.Sample(videoSampler,from);
    float decay=exp2(-clamp(iTimeDelta,0.0,0.25)/max(retention,0.05));
    return float4(max(fresh.rgb,history.rgb*decay),fresh.a);
}
float4 PSDisplay(VertData v):TARGET {
    float4 fresh=image.Sample(videoSampler,v.uv);
    if(iSightFlowPresent<0.5||clear_history||effect_mix<=0.0001)return fresh;
    float3 echo=iBufferB.Sample(videoSampler,v.uv).rgb;
    return float4(lerp(fresh.rgb,echo,saturate(effect_mix)),fresh.a);
}
technique BufferA {pass {vertex_shader=VSDefault(v);pixel_shader=PSStore(v);}}
technique BufferB {pass {vertex_shader=VSDefault(v);pixel_shader=PSEcho(v);}}
technique Draw {pass {vertex_shader=VSDefault(v);pixel_shader=PSDisplay(v);}}
