// @label "Liquid Light"
// @description "Audio-reactive colored oil and drifting light, layered over video with persistent pigment."
// Procedural advection and feedback, not a physical fluid simulation.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d hs_buffer_a;
uniform texture2d hs_buffer_b;
uniform texture2d hs_buffer_a_previous;
uniform texture2d hs_buffer_b_previous;
uniform float3 hs_resolution;
uniform float hs_time;
uniform int hs_graph_frame;
uniform float audio_band0;
uniform float audio_band1;
uniform float audio_band4;
uniform float audio_band7;
uniform float flow_speed; // @min 0.0 @max 2.0 @step 0.05 @default 0.65 @label "Flow Speed" @group "Liquid"
uniform float swirl; // @min 0.0 @max 2.0 @step 0.05 @default 0.85 @label "Swirl" @group "Liquid"
uniform float persistence; // @min 0.0 @max 0.99 @step 0.01 @default 0.90 @label "Pigment Memory" @group "Liquid"
uniform float audio_response; // @min 0.0 @max 3.0 @step 0.05 @default 1.0 @label "Audio Response" @group "Audio"
uniform float video_influence; // @min 0.0 @max 1.0 @step 0.05 @default 0.35 @label "Video Influence" @group "Look"
uniform float effect_mix; // @min 0.0 @max 1.0 @step 0.01 @default 0.85 @label "Effect Mix" @group "Output"

sampler_state liquidSampler { Filter=Linear; AddressU=Clamp; AddressV=Clamp; };
struct VertData { float4 pos:POSITION; float2 uv:TEXCOORD0; };
VertData VSDefault(VertData v) {
    VertData o; o.pos=mul(float4(v.pos.xyz,1.0),ViewProj); o.uv=v.uv; return o;
}
float luminance(float3 c) { return dot(c,float3(0.2126,0.7152,0.0722)); }
float4 PSFlow(VertData v):TARGET {
    float2 uv=v.uv;
    float bass=saturate((audio_band0+audio_band1)*0.5*audio_response);
    float t=hs_time*flow_speed;
    float2 center=uv-float2(0.5+0.13*sin(t*0.22),0.5+0.10*cos(t*0.17));
    float2 velocity=float2(-center.y,center.x)*exp(-dot(center,center)*3.5)*swirl*0.008;
    velocity+=float2(sin(uv.y*13.0+t*0.41),cos(uv.x*11.0-t*0.33))*0.0025;
    velocity*=flow_speed*(1.0+bass*1.5);
    float2 previous=hs_graph_frame==0 ? float2(0,0) :
                    (hs_buffer_a_previous.Sample(liquidSampler,uv).rg-0.5)/20.0;
    velocity=clamp(lerp(velocity,previous,0.65),float2(-0.02,-0.02),float2(0.02,0.02));
    return float4(0.5+velocity*20.0,0,1);
}
float4 PSPigment(VertData v):TARGET {
    float2 uv=v.uv;
    float2 velocity=(hs_buffer_a.Sample(liquidSampler,uv).rg-0.5)/20.0;
    float3 old=hs_graph_frame==0 ? float3(0,0,0) : hs_buffer_b_previous.Sample(liquidSampler,uv-velocity).rgb;
    float bass=saturate((audio_band0+audio_band1)*0.5*audio_response);
    float mid=saturate(audio_band4*audio_response);
    float t=hs_time*flow_speed;
    float2 p=uv-float2(0.5,0.5);
    p.x*=hs_resolution.x/max(hs_resolution.y,1.0);
    float field=sin(p.x*9.0+sin(p.y*7.0+t*0.35)*1.5+t*0.21);
    field+=cos(p.y*10.0+sin(p.x*6.0-t*0.24)*1.7-t*0.15);
    float pools=smoothstep(-0.35,0.65,field);
    float veins=exp(-abs(field)*5.0);
    float source=luminance(image.Sample(liquidSampler,uv).rgb);
    float3 amber=float3(1.0,0.24,0.035);
    float3 violet=float3(0.24,0.035,0.86);
    float3 cyan=float3(0.02,0.68,0.78);
    float3 color=lerp(violet,amber,pools);
    color=lerp(color,cyan,veins*(0.35+0.35*mid));
    color*=0.55+0.35*pools+0.2*bass;
    color*=lerp(1.0,0.35+source,video_influence);
    return float4(saturate(lerp(color,old,persistence)),1);
}
float4 PSFinal(VertData v):TARGET {
    float4 source=image.Sample(liquidSampler,v.uv);
    float3 pigment=hs_buffer_b.Sample(liquidSampler,v.uv).rgb;
    float high=saturate(audio_band7*audio_response);
    float2 px=1.0/max(hs_resolution.xy,float2(1,1));
    float edge=abs(luminance(pigment)-luminance(hs_buffer_b.Sample(liquidSampler,v.uv+px*2.0).rgb));
    float3 light=saturate(pigment*(1.1+0.3*high)+edge*float3(1.0,0.72,0.45)*(1.0+high));
    return float4(lerp(source.rgb,light,effect_mix),source.a);
}
technique BufferA {pass {vertex_shader=VSDefault(v);pixel_shader=PSFlow(v);}}
technique BufferB {pass {vertex_shader=VSDefault(v);pixel_shader=PSPigment(v);}}
technique Draw {pass {vertex_shader=VSDefault(v);pixel_shader=PSFinal(v);}}
