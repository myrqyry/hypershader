// P-Frame Drift — Lost Reference Stream
// Codec-inspired P-frame residual loss; clean I-frames reset corrupted feedback.
// No decorative RGB glitch overlays or random static.
//
// This is NOT an MPEG/H.264 bitstream decoder and does not read real codec
// motion vectors. It uses native HyperShader output-frame feedback to approximate
// the characteristic accumulation of inter-frame prediction errors.
// A keyframe replaces the damaged decoded picture with the actual live source.
// Native self-contained OBS effect: no imports, macros or external shader
// preprocessor dependencies. Built-in variables are managed by HyperShaderFX.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform float3 hs_resolution;
uniform float hs_time;
uniform float hs_delta_time;
uniform int hs_frame_index;
sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};
struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};
VertData VSDefault(VertData v_in) {
    VertData v_out;
    v_out.pos=mul(float4(v_in.pos.xyz,1.0),ViewProj);
    v_out.uv=v_in.uv;
    return v_out;
}


uniform texture2d hs_history;

// @min 0.0 @max 1.0 @step 0.01 @default 0.88 @label "P-Frame Loss" @group "Prediction"
uniform float pframe_loss;

// @min 0.0 @max 1.0 @step 0.01 @default 0.92 @label "Missing Residual" @group "Prediction"
uniform float missing_residual;

// @min 8.0 @max 64.0 @step 8.0 @default 16.0 @label "Macroblock Size (px)" @group "Prediction"
uniform float macroblock_size;

// @min 0.0 @max 3.0 @step 0.05 @default 1.6 @label "Motion Vector Carry" @group "Prediction"
uniform float vector_carry;

// @min 0.0 @max 0.4 @step 0.01 @default 0.025 @label "Residual Recovery" @group "Recovery"
uniform float residual_recovery;

// @min 0.0 @max 30.0 @step 0.5 @default 12.0 @label "Clean I-Frame Every (s; 0=never)" @group "Recovery"
uniform float iframe_interval;

// @min 0.0 @max 1.0 @step 1.0 @default 0.0 @label "Force Clean Keyframe" @group "Recovery"
uniform float force_keyframe;

// @min 0.0 @max 25.0 @step 0.5 @default 0.0 @label "Loss Burst Period (s; 0=continuous)" @group "Network"
uniform float burst_period;

// @min 0.05 @max 1.0 @step 0.01 @default 0.68 @label "Burst Duty Cycle" @group "Network"
uniform float burst_duty;

// @min 0.0 @max 1.0 @step 0.01 @default 0.08 @label "Chroma Residual Loss" @group "Prediction"
uniform float chroma_loss;

float hash_cell(float2 p) {
    return frac(sin(dot(p,float2(127.1,311.7))) * 43758.5453);
}
float luma(float3 c) {
    return dot(c,float3(.299,.587,.114));
}
float2 nearest_motion(float2 block_center,float2 pixel,float radius) {
    // Cheap block-matching proxy. We compare current encoded macroblock
    // center against spatial candidates in the previous *decoded output*.
    // Candidate UV points back to old content for motion compensation.
    float3 now = image.Sample(textureSampler,block_center).rgb;
    float2 shiftX = float2(pixel.x * radius,0.0);
    float2 shiftY = float2(0.0,pixel.y * radius);
    float2 best = float2(0.0,0.0);
    float previous_luma = luma(hs_history.Sample(textureSampler,block_center).rgb);
    float best_error = abs(luma(now)-previous_luma);
    float candidate_luma = luma(hs_history.Sample(textureSampler,
        saturate(block_center+shiftX)).rgb);
    float error = abs(luma(now)-candidate_luma) + .018;
    if(error<best_error){best_error=error;best=shiftX;}
    candidate_luma=luma(hs_history.Sample(textureSampler,
        saturate(block_center-shiftX)).rgb);
    error=abs(luma(now)-candidate_luma)+.018;
    if(error<best_error){best_error=error;best=-shiftX;}
    candidate_luma=luma(hs_history.Sample(textureSampler,
        saturate(block_center+shiftY)).rgb);
    error=abs(luma(now)-candidate_luma)+.018;
    if(error<best_error){best_error=error;best=shiftY;}
    candidate_luma=luma(hs_history.Sample(textureSampler,
        saturate(block_center-shiftY)).rgb);
    error=abs(luma(now)-candidate_luma)+.018;
    if(error<best_error){best_error=error;best=-shiftY;}
    // Per-block vectors create coherent inherited motion, not pixel noise.
    return best;
}

void hs_shade_pixel(out float4 fragColor,in float2 fragCoord) {
    float2 res=max(hs_resolution.xy,float2(1.0,1.0));
    float2 uv=fragCoord/res;
    float4 incoming=image.Sample(textureSampler,uv);
    // No incoming source? No fabricated content, preserve source alpha.
    if(pframe_loss<=.0001||force_keyframe>.5||hs_frame_index<3) {
        fragColor=incoming;
        return;
    }
    float4 prior=hs_history.Sample(textureSampler,uv);
    // The ping-pong buffer is initially transparent; never bootstrap from
    // undefined/empty history. OBS filters may be attached to alpha sources.
    if(prior.a<.01) {
        fragColor=incoming;
        return;
    }
    if(iframe_interval>.05) {
        float period=max(iframe_interval,.25);
        float key_width=max(.006,min(.22,hs_delta_time*1.6/period));
        if(frac(hs_time/period)<key_width) {
            fragColor=incoming; // Clean intra frame: full reset of error chain.
            return;
        }
    }
    // Optional network-level loss bursts. This gate affects missing residuals,
    // not the motion estimator, which is always driven by source pixels.
    float loss_gate=1.0;
    if(burst_period>.05) {
        float stage=frac(hs_time/max(.25,burst_period));
        loss_gate=1.0-step(saturate(burst_duty),stage);
    }
    if(loss_gate<.5) {
        // Healthy interval / recovery. A new clean picture flushes history
        // instead of continuing to accumulate synthetic glitch textures.
        fragColor=incoming;
        return;
    }

    float cell_size=max(8.0,macroblock_size);
    float2 cell=floor(fragCoord/cell_size);
    float2 center=saturate((cell+.5)*cell_size/res);
    float cell_entropy=hash_cell(cell);
    // Stagger loss by macroblock, keeping whole predicted regions coherent.
    float corrupt=saturate((pframe_loss-.15) * 1.35 +
                           (cell_entropy-.5) * .45);
    float2 motion=nearest_motion(center,1.0/res,
                                 min(cell_size*.55,16.0)) * vector_carry;
    float2 old_uv=saturate(uv+motion);
    float4 predicted=hs_history.Sample(textureSampler,old_uv);

    // Motion prediction on damaged reference data propagates the visual
    // error forward every frame. No other frame history buffer is needed.
    // Missing residual data means very little original picture corrects it.
    float correction=saturate(1.0-corrupt*missing_residual);
    correction=max(correction,residual_recovery);

    float3 result=lerp(predicted.rgb,incoming.rgb,correction);
    // Chroma residual loss can smear old color over otherwise recovered
    // luma. Off by default-ish and deliberately not an RGB split.
    float old_y=luma(predicted.rgb);
    float new_y=luma(result);
    result=lerp(result,
        saturate(result - float3(new_y,new_y,new_y) +
                 predicted.rgb - float3(old_y,old_y,old_y) +
                 float3(new_y,new_y,new_y)),
        chroma_loss*corrupt*.5);
    fragColor=float4(saturate(result),incoming.a);
}
float4 PSMain(VertData v_in) : TARGET {
    float4 color;
    hs_shade_pixel(color,v_in.uv*hs_resolution.xy);
    return color;
}
technique Draw {
    pass {
        vertex_shader=VSDefault(v_in);
        pixel_shader=PSMain(v_in);
    }
}
