// @label "Sight: Semantic Prism"
// @description "Remap selected semantic regions into an illustrated duotone, pixel mosaic or solid color. Uses Sight analysis-only; creative effect, not guaranteed redaction."
uniform float4x4 ViewProj;
uniform texture2d image;
uniform float3 hs_resolution;
uniform texture2d hs_sight_semantic_mask;
uniform texture2d hs_sight_semantic_bounds;
uniform texture2d hs_sight_semantic_meta;
uniform float hs_sight_semantic_present;
uniform int hs_sight_semantic_count;
uniform int region_mode; // @label "Treatment" @list "Duotone,Mosaic,Solid" @default 0 @group "Prism"
uniform int category_id; // @label "Category (-1 = all)" @min -1 @max 1023 @step 1 @default -1 @group "Prism"
uniform float amount; // @label "Mix" @min 0 @max 1 @step 0.01 @default 1 @group "Prism"
uniform float4 ink_color; // @label "Shadow / Solid Color" @default "0.12,0.05,0.22,1.0" @group "Palette"
uniform float4 light_color; // @label "Highlight Color" @default "1.0,0.67,0.36,1.0" @group "Palette"
uniform float levels; // @label "Tonal Steps" @min 2 @max 16 @step 1 @default 5 @group "Palette" @show_if "region_mode == 0"
uniform float cell_size; // @label "Mosaic Cell (px)" @min 4 @max 64 @step 1 @default 16 @group "Prism" @show_if "region_mode == 1"
sampler_state sourceSampler { Filter=Linear; AddressU=Clamp; AddressV=Clamp; };
sampler_state maskSampler { Filter=Point; AddressU=Clamp; AddressV=Clamp; };
struct VertData { float4 pos:POSITION; float2 uv:TEXCOORD0; };
VertData VSDefault(VertData v){v.pos=mul(float4(v.pos.xyz,1),ViewProj);return v;}
float4 PSMain(VertData v):TARGET {
    float4 original=image.Sample(sourceSampler,v.uv);
    if(hs_sight_semantic_present<0.5||hs_sight_semantic_count<1||amount<=0.0)return original;
    if(hs_sight_semantic_mask.Sample(maskSampler,v.uv).r<0.5)return original;
    // The union-mask fast path needs no region loop. For a specific class,
    // examine only pixels inside that mask and use exact normalized bounds.
    if(category_id>=0){
        bool found=false;
        for(int i=0;i<min(hs_sight_semantic_count,256);i++){
            float4 m=hs_sight_semantic_meta.Load(int3(i,0,0));
            if(m.x==float(category_id)){
                float4 b=hs_sight_semantic_bounds.Load(int3(i,0,0));
                if(v.uv.x>=b.x&&v.uv.y>=b.y&&v.uv.x<=b.z&&v.uv.y<=b.w){found=true;break;}
            }
        }
        if(!found)return original;
    }
    float3 target=ink_color.rgb;
    if(region_mode==0){
        float l=dot(original.rgb,float3(0.2126,0.7152,0.0722));
        float steps=max(levels-1.0,1.0);
        float q=floor(saturate(l)*steps+0.5)/steps;
        target=lerp(ink_color.rgb,light_color.rgb,q);
    }else if(region_mode==1){
        float2 resolution=max(hs_resolution.xy,float2(1,1));
        float cell=max(cell_size,1.0);
        float2 uv=(floor(v.uv*resolution/cell)+0.5)*cell/resolution;
        target=image.Sample(sourceSampler,saturate(uv)).rgb;
    }
    return float4(lerp(original.rgb,target,saturate(amount)),original.a);
}
technique Draw {pass{vertex_shader=VSDefault(v);pixel_shader=PSMain(v);}}
