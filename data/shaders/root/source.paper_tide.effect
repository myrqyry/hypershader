// @label "Paper Tide"
// @description "Layered ink-water coastlines. Eight real FFT band values modulate separate handmade contours; beat phase shifts the paper grain."
// Original native HyperShaderFX instrument, authored for this collection.
#include "../../stdlib/hypershader_standard.glsl"
uniform float swell; // @min 0 @max 0.25 @step 0.005 @default 0.10 @label "Wave Height" @group "Shape"
uniform float detail; // @min 0.5 @max 5 @step 0.05 @default 2.2 @label "Contour Detail" @group "Shape"
uniform float flow; // @min 0 @max 2 @step 0.05 @default 0.28 @label "Horizontal Drift" @group "Motion"
uniform float audio_gain; // @min 0 @max 6 @step 0.1 @default 2.5 @label "Audio Tide" @group "Motion"
uniform float3 paper_color; // @default "0.89,0.83,0.70" @label "Paper" @group "Palette"
uniform float3 low_ink; // @default "0.19,0.34,0.34" @label "Deep Ink" @group "Palette"
uniform float3 high_ink; // @default "0.63,0.40,0.37" @label "Warm Ink" @group "Palette"

float tideBand(int i) {
 if(i==0)return audio_band0;if(i==1)return audio_band1;
 if(i==2)return audio_band2;if(i==3)return audio_band3;
 if(i==4)return audio_band4;if(i==5)return audio_band5;
 if(i==6)return audio_band6;return audio_band7;
}
void hs_shade_pixel(out vec4 fragColor,in vec2 fragCoord) {
 float2 size=max(hs_resolution.xy,float2(1,1)),uv=fragCoord/size;
 float2 p=float2(uv.x*size.x/size.y,uv.y);
 float time=hs_time*flow;
 float grain=frac(sin(dot(floor(fragCoord)+floor(audio_beat_phase*4.0),
                       float2(37.71,113.5)))*22578.18);
 float3 color=paper_color*(0.95+grain*0.07);
 float thin=1.5/size.y;
 float breath=0.65+0.35*saturate(audio_envelope*audio_gain);
 for(int i=0;i<8;i++) {
    float f=float(i),level=saturate(tideBand(i)*audio_gain);
    float wave=sin(p.x*(2.0+detail*0.55)+f*0.79+time*(0.45+f*0.08));
    wave+=0.32*sin(p.x*(4.3+detail)+f*2.11-time*0.37);
    float coast=0.13+f*0.103 + swell*wave*(0.3+0.70*breath)+level*0.035;
    float thickness=0.002+level*0.003;
    float edge=1.0-smoothstep(thickness,thickness+thin,abs(uv.y-coast));
    float bed=smoothstep(0.0,0.015,uv.y-coast)*(1.0-smoothstep(0.05,0.18,uv.y-coast));
    float3 ink=lerp(low_ink,high_ink,f/7.0);
    color=lerp(color,ink,edge*0.83+bed*0.13);
 }
 // Tiny registration specks, not an extra animated frequency band.
 float speck=step(0.997,grain);
 color=lerp(color,low_ink,speck*0.13);
 fragColor=float4(saturate(color),1);
}
HYPERSHADER_PIXEL_WRAPPER
