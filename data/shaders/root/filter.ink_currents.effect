// @label "Ink Currents"
// @description "Two persistent fields: source-responsive velocity and pigmented advection."
uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d iBufferA;
uniform texture2d iBufferB;
uniform texture2d iBufferAPrevious;
uniform texture2d iBufferBPrevious;
uniform float3 iResolution;
uniform float iTime;
uniform int iGraphFrame;
uniform float current_speed; // @min 0.1 @max 2.0 @step 0.05 @default 0.90 @label "Current Speed" @group "Flow"
uniform float vortex_strength; // @min 0.0 @max 2.0 @step 0.05 @default 0.85 @label "Vortex Strength" @group "Flow"
uniform float edge_response; // @min 0.0 @max 2.0 @step 0.05 @default 0.65 @label "Video Edge Force" @group "Flow"
uniform float flow_memory; // @min 0.0 @max 0.98 @step 0.01 @default 0.80 @label "Velocity Inertia" @group "Flow"
uniform float pigment_decay; // @min 0.65 @max 0.995 @step 0.005 @default 0.972 @label "Pigment Lifetime" @group "Pigment"
uniform float pigment_injection; // @min 0.0 @max 1.5 @step 0.05 @default 0.62 @label "Edge Pigment" @group "Pigment"
uniform float color_shift; // @min 0.0 @max 1.0 @step 0.01 @default 0.72 @label "Teal to Coral" @group "Pigment"
uniform float effect_mix; // @min 0.0 @max 1.0 @step 0.01 @default 0.79 @label "Effect Mix" @group "Output"

sampler_state simSampler { Filter=Linear; AddressU=Clamp; AddressV=Clamp; };
struct VertData { float4 pos:POSITION;float2 uv:TEXCOORD0; };
VertData VSDefault(VertData v) {
    VertData o;o.pos=mul(float4(v.pos.xyz,1),ViewProj);o.uv=v.uv;return o;
}
float lightness(float3 c) { return dot(c,float3(0.2126,0.7152,0.0722)); }
float2 velocityAt(float2 uv) {
    return (iBufferA.Sample(simSampler,uv).rg-0.5)/20.0;
}
float4 PSVelocity(VertData v):TARGET {
    float2 uv=v.uv;
    float2 px=1.0/max(iResolution.xy,float2(1,1));
    float left=lightness(image.Sample(simSampler,uv-float2(px.x,0)).rgb);
    float right=lightness(image.Sample(simSampler,uv+float2(px.x,0)).rgb);
    float top=lightness(image.Sample(simSampler,uv-float2(0,px.y)).rgb);
    float bottom=lightness(image.Sample(simSampler,uv+float2(0,px.y)).rgb);
    float2 gradient=float2(right-left,bottom-top);
    float2 center=uv-float2(0.5+0.14*sin(iTime*0.15),
                            0.5+0.1*cos(iTime*0.22));
    float envelope=exp(-dot(center,center)*3.4);
    float2 curl=float2(-center.y,center.x)*0.009*vortex_strength*envelope;
    curl+=0.002*float2(sin(uv.y*16.0+iTime*0.46),
                        cos(uv.x*14.0-iTime*0.32));
    float2 edgeCurrent=float2(-gradient.y,gradient.x)*0.007*edge_response;
    float2 fresh=(curl+edgeCurrent)*current_speed;
    float2 old=iGraphFrame==0 ? float2(0,0) :
              (iBufferAPrevious.Sample(simSampler,uv).rg-0.5)/20.0;
    float2 vel=lerp(fresh,old,flow_memory);
    vel=clamp(vel,float2(-0.02,-0.02),float2(0.02,0.02));
    return float4(saturate(0.5+vel.x*20.0),
                  saturate(0.5+vel.y*20.0),lightness(image.Sample(simSampler,uv).rgb),1);
}
float4 PSPigment(VertData v):TARGET {
    float2 uv=v.uv;
    float2 velocity=velocityAt(uv);
    float3 old=iGraphFrame==0 ? float3(0,0,0) :
          iBufferBPrevious.Sample(simSampler,uv-velocity).rgb;
    float2 px=1.0/max(iResolution.xy,float2(1,1));
    float brightness=lightness(image.Sample(simSampler,uv).rgb);
    float x=lightness(image.Sample(simSampler,uv+float2(px.x,0)).rgb);
    float y=lightness(image.Sample(simSampler,uv+float2(0,px.y)).rgb);
    float edge=saturate((abs(x-brightness)+abs(y-brightness))*5.5);
    float injection=saturate(edge*0.75+brightness*0.28)*pigment_injection;
    float3 teal=float3(0.09,0.65,0.78);
    float3 coral=float3(1.0,0.28,0.19);
    float3 palette=lerp(teal,coral,saturate(brightness*color_shift+0.2));
    float3 newColor=old*pigment_decay+palette*injection*0.19;
    return float4(saturate(newColor),1);
}
float4 PSFinal(VertData v):TARGET {
    float2 uv=v.uv;
    float4 source=image.Sample(simSampler,uv);
    float2 vel=velocityAt(uv);
    float3 advected=iBufferB.Sample(simSampler,uv).rgb;
    float3 blurred=(iBufferB.Sample(simSampler,uv+vel*2.0).rgb+
                    iBufferB.Sample(simSampler,uv-vel*2.0).rgb)*0.5;
    float3 paint=saturate(advected*0.94+blurred*0.42);
    float3 smear=image.Sample(simSampler,uv-vel*1.5).rgb*0.22;
    float3 layered=saturate(source.rgb*0.30+smear+paint);
    return float4(lerp(source.rgb,layered,effect_mix),source.a);
}
technique BufferA {pass {vertex_shader=VSDefault(v);pixel_shader=PSVelocity(v);}}
technique BufferB {pass {vertex_shader=VSDefault(v);pixel_shader=PSPigment(v);}}
technique Draw {pass {vertex_shader=VSDefault(v);pixel_shader=PSFinal(v);}}
