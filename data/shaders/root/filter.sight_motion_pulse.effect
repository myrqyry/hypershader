// @label "Sight: Motion Pulse"
// @description "Pulse the foreground color and edge glow with measured source movement, optionally modulated by audio beats."
uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d hs_segmentation;
uniform float hs_sight_matte_present;
uniform float hs_sight_motion_present;
uniform float hs_sight_motion_energy;
uniform float audio_beat;
uniform float3 hs_resolution;
uniform float sensitivity; // @label "Motion Sensitivity" @min 0.1 @max 20 @step 0.1 @default 8 @group "Motion"
uniform float pulse_mix; // @label "Effect Mix" @min 0 @max 1 @step 0.01 @default 0.85 @group "Look"
uniform float audio_mix; // @label "Audio Beat Modulation" @min 0 @max 1 @step 0.01 @default 0 @group "Motion"
uniform float4 pulse_color; // @label "Pulse Color" @default "0.15,0.85,1.0,1.0" @group "Look"
uniform bool show_motion; // @label "View Motion Energy" @default false @group "Debug"
sampler_state sourceSampler { Filter=Linear; AddressU=Clamp; AddressV=Clamp; };
struct VertData {float4 pos:POSITION;float2 uv:TEXCOORD0;};
VertData VSDefault(VertData v) {
    VertData o;o.pos=mul(float4(v.pos.xyz,1),ViewProj);o.uv=v.uv;return o;
}
float4 PSMain(VertData v):TARGET {
    float4 original=image.Sample(sourceSampler,v.uv);
    if (hs_sight_motion_present<0.5 || pulse_mix<=0.0) return original;
    float energy=saturate(hs_sight_motion_energy*sensitivity);
    float pulse=saturate(energy*(1.0+audio_mix*saturate(audio_beat)));
    if (show_motion) return float4(lerp(original.rgb,float3(energy,energy,energy),pulse_mix),original.a);
    if (hs_sight_matte_present<0.5 || pulse<=0.0) return original;
    float2 dx=float2(3.0/max(hs_resolution.x,1.0),0);
    float2 dy=float2(0,3.0/max(hs_resolution.y,1.0));
    float m=hs_segmentation.Sample(sourceSampler,v.uv).r;
    float edge=max(abs(hs_segmentation.Sample(sourceSampler,v.uv+dx).r-hs_segmentation.Sample(sourceSampler,v.uv-dx).r),
                   abs(hs_segmentation.Sample(sourceSampler,v.uv+dy).r-hs_segmentation.Sample(sourceSampler,v.uv-dy).r));
    float amount=saturate(pulse*pulse_mix*pulse_color.a*(0.35*m+0.9*edge));
    return float4(lerp(original.rgb,pulse_color.rgb,amount),original.a);
}
technique Draw {pass {vertex_shader=VSDefault(v);pixel_shader=PSMain(v);}}
