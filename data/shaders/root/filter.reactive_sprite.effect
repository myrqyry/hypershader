// @label "Reactive Sprite"
// @description "Animate existing OBS video or image sources with audio. Optional channels 0-2 provide active, strong, and accent replacement images."
uniform texture2d image;
uniform texture2d iChannel0;
uniform texture2d iChannel1;
uniform texture2d iChannel2;
uniform float4 iChannelResolution0;
uniform float4 iChannelAtlas0;
uniform float4 iChannelResolution1;
uniform float4 iChannelAtlas1;
uniform float4 iChannelResolution2;
uniform float4 iChannelAtlas2;
uniform float4x4 ViewProj;
uniform float3 iResolution;
uniform float iTime;
uniform float4 audio_reaction_state; // host-owned: three state weights + spring position
uniform float audio_kick;
uniform float audio_snare;

uniform int response_driver; // @list "Voice / level,Peak,Kick,Bass,Mid,High" @default 0 @label "Reaction Driver" @group "Reaction"
uniform float sensitivity; // @min 0 @max 20 @step 0.1 @default 1 @label "Sensitivity" @group "Reaction"
uniform float threshold; // @min 0 @max 1 @step 0.001 @default 0.025 @label "Activation Threshold" @group "Reaction"
uniform float transition_width; // @min 0 @max 0.5 @step 0.001 @default 0.045 @label "Crossfade Width (0 = instant)" @group "Reaction"
uniform float strong_threshold; // @min 0.01 @max 1 @step 0.01 @default 0.16 @label "Strong Reaction Threshold" @group "Reaction"
uniform float accent_threshold; // @min 0.01 @max 1 @step 0.01 @default 0.3 @label "Accent Reaction Threshold" @group "Reaction"
uniform int animation_playback; // @list "Continuous,Restart on reaction,Pause / resume" @default 1 @label "Animated Images" @group "Playback"
uniform int active_atlas_columns; // @min 1 @max 64 @step 1 @default 1 @label "Columns" @group "Active Sprite Sheet"
uniform int active_atlas_rows; // @min 1 @max 64 @step 1 @default 1 @label "Rows" @group "Active Sprite Sheet"
uniform int active_atlas_first; // @min 0 @max 4095 @step 1 @default 0 @label "First Frame (0-based)" @group "Active Sprite Sheet"
uniform int active_atlas_count; // @min 0 @max 4096 @step 1 @default 0 @label "Frame Count (0 = all remaining)" @group "Active Sprite Sheet"
uniform float active_atlas_fps; // @min 0 @max 60 @step 0.5 @default 12 @label "Frames per Second" @group "Active Sprite Sheet"
uniform int active_atlas_mode; // @list "Loop,One shot,Ping pong,Random frames" @default 0 @label "Sequence" @group "Active Sprite Sheet"
uniform int strong_atlas_columns; // @min 1 @max 64 @step 1 @default 1 @label "Columns" @group "Strong Sprite Sheet"
uniform int strong_atlas_rows; // @min 1 @max 64 @step 1 @default 1 @label "Rows" @group "Strong Sprite Sheet"
uniform int strong_atlas_first; // @min 0 @max 4095 @step 1 @default 0 @label "First Frame (0-based)" @group "Strong Sprite Sheet"
uniform int strong_atlas_count; // @min 0 @max 4096 @step 1 @default 0 @label "Frame Count (0 = all remaining)" @group "Strong Sprite Sheet"
uniform float strong_atlas_fps; // @min 0 @max 60 @step 0.5 @default 12 @label "Frames per Second" @group "Strong Sprite Sheet"
uniform int strong_atlas_mode; // @list "Loop,One shot,Ping pong,Random frames" @default 0 @label "Sequence" @group "Strong Sprite Sheet"
uniform int accent_atlas_columns; // @min 1 @max 64 @step 1 @default 1 @label "Columns" @group "Accent Sprite Sheet"
uniform int accent_atlas_rows; // @min 1 @max 64 @step 1 @default 1 @label "Rows" @group "Accent Sprite Sheet"
uniform int accent_atlas_first; // @min 0 @max 4095 @step 1 @default 0 @label "First Frame (0-based)" @group "Accent Sprite Sheet"
uniform int accent_atlas_count; // @min 0 @max 4096 @step 1 @default 0 @label "Frame Count (0 = all remaining)" @group "Accent Sprite Sheet"
uniform float accent_atlas_fps; // @min 0 @max 60 @step 0.5 @default 12 @label "Frames per Second" @group "Accent Sprite Sheet"
uniform int accent_atlas_mode; // @list "Loop,One shot,Ping pong,Random frames" @default 0 @label "Sequence" @group "Accent Sprite Sheet"
uniform bool temporal_response; // @default true @label "Temporal Response" @group "Dynamics"
uniform float hysteresis; // @min 0 @max 0.2 @step 0.001 @default 0.008 @label "Hysteresis" @group "Dynamics"
uniform float attack_ms; // @min 0 @max 500 @step 5 @default 35 @label "Attack (ms)" @group "Dynamics"
uniform float hold_ms; // @min 0 @max 1000 @step 5 @default 90 @label "Hold (ms)" @group "Dynamics"
uniform float release_ms; // @min 0 @max 1000 @step 5 @default 120 @label "Release (ms)" @group "Dynamics"
uniform float spring_frequency; // @min 0.5 @max 8 @step 0.1 @default 3 @label "Spring Frequency (Hz)" @group "Dynamics"
uniform float spring_damping; // @min 0.15 @max 2 @step 0.05 @default 0.55 @label "Spring Damping" @group "Dynamics"
uniform float bounce; // @min 0 @max 0.3 @step 0.005 @default 0.045 @label "Bounce" @group "Motion"
uniform float stretch; // @min 0 @max 0.4 @step 0.01 @default 0.12 @label "Squash and Stretch" @group "Motion"
uniform float tilt; // @min 0 @max 30 @step 0.5 @default 3 @label "Tilt (degrees)" @group "Motion"
uniform float idle_breathe; // @min 0 @max 0.08 @step 0.002 @default 0 @label "Idle Breathing" @group "Motion"
uniform float anchor_y; // @min 0 @max 1 @step 0.01 @default 0.85 @label "Vertical Anchor" @group "Motion"
uniform float glow; // @min 0 @max 1 @step 0.01 @default 0 @label "Reactive Glow" @group "Appearance"
uniform float3 glow_color; // @default "1.0,0.55,0.35" @label "Glow Color" @group "Appearance"

sampler_state spriteSampler { Filter=Linear; AddressU=Clamp; AddressV=Clamp; };
struct VertData { float4 pos:POSITION; float2 uv:TEXCOORD0; };
VertData VSDefault(VertData v) {
    VertData o; o.pos=mul(float4(v.pos.xyz,1.0),ViewProj); o.uv=v.uv; return o;
}

float2 motionUV(float2 uv,float energy,float spring) {
    float aspect=max(iResolution.x/max(iResolution.y,1.0),0.001);
    float2 anchor=float2(0.5,anchor_y);
    float breath=sin(iTime*2.1)*idle_breathe*(1.0-energy);
    float impact=spring*0.65+audio_kick*energy*0.35;
    float sy=1.0+stretch*(impact-0.5*audio_snare*energy)+breath;
    float sx=1.0/max(sy,0.25);
    float angle=tilt*0.017453293*(temporal_response ? spring-energy : energy*sin(iTime*7.0));
    float2 p=(uv-anchor+float2(0,bounce*impact))*float2(aspect,1);
    p=float2(cos(angle)*p.x+sin(angle)*p.y,-sin(angle)*p.x+cos(angle)*p.y);
    p/=float2(sx,max(sy,0.25));
    return p/float2(aspect,1)+anchor;
}
float2 fitUV(float2 uv,float2 dimensions) {
    float ratio=(iResolution.x/max(iResolution.y,1.0))/max(dimensions.x/max(dimensions.y,1.0),0.001);
    return (uv-0.5)*float2(max(ratio,1.0),max(1.0/max(ratio,0.001),1.0))+0.5;
}
bool outside(float2 uv) { return uv.x<0.0 || uv.x>1.0 || uv.y<0.0 || uv.y>1.0; }
float4 read_image(float2 uv,float2 dimensions) {
    if(dimensions.x<1.0 || dimensions.y<1.0) return float4(0,0,0,0);
    uv=fitUV(uv,dimensions);
    if(outside(uv)) return float4(0,0,0,0);
    return image.Sample(spriteSampler,uv);
}
float4 read_iChannel0(float2 uv,float2 dimensions) {
    if(dimensions.x<1.0 || dimensions.y<1.0) return float4(0,0,0,0);
    float2 grid=max(float2(1,1),min(iChannelAtlas0.xy,dimensions));
    float2 cell=floor(dimensions/grid);
    uv=fitUV(uv,cell);
    if(outside(uv)) return float4(0,0,0,0);
    float frame=min(iChannelAtlas0.z,grid.x*grid.y-1.0);
    float row=floor(frame/grid.x);
    float2 offset=float2(frame-row*grid.x,row)*cell;
    // Sample only inside this cell, including at the fitted image edges.
    if(grid.x*grid.y>1.0)
        uv=(offset+0.5+uv*max(cell-1.0,0.0))/dimensions;
    return iChannel0.Sample(spriteSampler,uv);
}
float4 read_iChannel1(float2 uv,float2 dimensions) {
    if(dimensions.x<1.0 || dimensions.y<1.0) return float4(0,0,0,0);
    float2 grid=max(float2(1,1),min(iChannelAtlas1.xy,dimensions));
    float2 cell=floor(dimensions/grid);
    uv=fitUV(uv,cell);
    if(outside(uv)) return float4(0,0,0,0);
    float frame=min(iChannelAtlas1.z,grid.x*grid.y-1.0);
    float row=floor(frame/grid.x);
    float2 offset=float2(frame-row*grid.x,row)*cell;
    // Sample only inside this cell, including at the fitted image edges.
    if(grid.x*grid.y>1.0)
        uv=(offset+0.5+uv*max(cell-1.0,0.0))/dimensions;
    return iChannel1.Sample(spriteSampler,uv);
}
float4 read_iChannel2(float2 uv,float2 dimensions) {
    if(dimensions.x<1.0 || dimensions.y<1.0) return float4(0,0,0,0);
    float2 grid=max(float2(1,1),min(iChannelAtlas2.xy,dimensions));
    float2 cell=floor(dimensions/grid);
    uv=fitUV(uv,cell);
    if(outside(uv)) return float4(0,0,0,0);
    float frame=min(iChannelAtlas2.z,grid.x*grid.y-1.0);
    float row=floor(frame/grid.x);
    float2 offset=float2(frame-row*grid.x,row)*cell;
    // Sample only inside this cell, including at the fitted image edges.
    if(grid.x*grid.y>1.0)
        uv=(offset+0.5+uv*max(cell-1.0,0.0))/dimensions;
    return iChannel2.Sample(spriteSampler,uv);
}
float4 spriteAt(float2 uv,float3 weights) {
    float4 col=read_image(uv,iResolution.xy);
    if(iChannelResolution0.x>0.0) col=lerp(col,read_iChannel0(uv,iChannelResolution0.xy),weights.x);
    if(iChannelResolution1.x>0.0) col=lerp(col,read_iChannel1(uv,iChannelResolution1.xy),weights.y);
    if(iChannelResolution2.x>0.0) col=lerp(col,read_iChannel2(uv,iChannelResolution2.xy),weights.z);
    return col;
}

float4 PSMain(VertData v):TARGET {
    float3 weights=audio_reaction_state.xyz;
    float energy=weights.x;
    float spring=temporal_response ? audio_reaction_state.w : energy;
    float2 uv=motionUV(v.uv,energy,spring);
    float4 col=spriteAt(uv,weights);
    if(glow>0.0 && energy>0.0) {
        float2 px=4.0/max(iResolution.xy,float2(1,1));
        float halo=0.25*(spriteAt(uv+float2(px.x,0),weights).a+
                         spriteAt(uv-float2(px.x,0),weights).a+
                         spriteAt(uv+float2(0,px.y),weights).a+
                         spriteAt(uv-float2(0,px.y),weights).a);
        float a=saturate(halo*energy*glow)*(1.0-col.a);
        col=float4(col.rgb+glow_color*a,col.a+a);
    }
    return col;
}
technique Draw { pass { vertex_shader=VSDefault(v); pixel_shader=PSMain(v); } }

// @audio (native audio inputs; no extra capture or metadata mapping)
