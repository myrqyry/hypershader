// @label "Afterimage Press"
// @description "Video is repeatedly impressed into a slowly fading two-ink plate using the actual prior rendered output. Spectral flux loosens registration."
// Original first-party HyperShader artwork. Requires hs_history history, owned by HyperShader.
// Source alpha is preserved; disable the filter to release its history.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d hs_history;
uniform float3 hs_resolution;
uniform float hs_time;
uniform float audio_flux;
uniform float history; // @min 0 @max 0.995 @step 0.005 @default 0.87 @label "Ink Memory" @group "Feedback"
uniform float offset_px; // @min 0 @max 20 @step 0.5 @default 4 @label "Plate Misregistration (px)" @group "Printing"
uniform float grain; // @min 0 @max 1 @step 0.01 @default 0.25 @label "Paper Grain" @group "Printing"
uniform float audio_response; // @min 0 @max 3 @step 0.05 @default 0.8 @label "Flux Response" @group "Feedback"
uniform float effect_mix; // @min 0 @max 1 @step 0.01 @default 0.72 @label "Ink Mix" @group "Output"
uniform float3 cool_ink; // @default "0.18,0.34,0.41" @label "Blue Plate" @group "Palette"
uniform float3 warm_ink; // @default "0.72,0.37,0.27" @label "Red Plate" @group "Palette"
sampler_state pressSampler{Filter=Linear;AddressU=Clamp;AddressV=Clamp;};
struct VertData{float4 pos:POSITION;float2 uv:TEXCOORD0;};
VertData VSDefault(VertData v){
    VertData o;o.pos=mul(float4(v.pos.xyz,1),ViewProj);o.uv=v.uv;return o;
}
float luminance(float3 c){return dot(c,float3(0.2126,0.7152,0.0722));}
float4 PSMain(VertData v):TARGET{
    float2 uv=v.uv;
    float4 src=image.Sample(pressSampler,uv);
    if(effect_mix<=0.0||src.a<=0.0001)return src;
    float2 pixel=1.0/max(hs_resolution.xy,float2(1,1));
    float drift=offset_px*(1.0+saturate(audio_flux)*audio_response);
    float2 registration=float2(drift,drift*0.39)*pixel;
    float4 prev=hs_history.Sample(pressSampler,saturate(uv+registration));
    float fade=saturate(history);
    float freshL=luminance(src.rgb);
    float oldL=luminance(prev.rgb);
    float shift=sin(hs_time*0.19+uv.y*17.0)*grain*0.15;
    float field=frac(sin(dot(floor(uv*hs_resolution.xy),float2(91.7,37.9)))*43758.5);
    float paper=0.87+(field-0.5)*grain*0.18;
    float3 cream=float3(0.93,0.87,0.76)*paper;
    float3 currentInk=lerp(cream,cool_ink,saturate(1.1-freshL)*0.86);
    float memory=fade*saturate(oldL+0.10)*(0.85+shift);
    float3 registered=lerp(currentInk,warm_ink,memory*0.52);
    // A little ghost signal survives even after the source goes dark,
    // but feedback is explicitly bounded by 'history'.
    registered+=prev.rgb*fade*0.18;
    float3 outRgb=lerp(src.rgb,saturate(registered),saturate(effect_mix));
    return float4(outRgb,src.a);
}
technique Draw{pass{vertex_shader=VSDefault(v);pixel_shader=PSMain(v);}}
