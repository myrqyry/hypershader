#include <plugin-support.h>

#include <obs-module.h>
#include <util/bmem.h>

const char *PLUGIN_NAME = "@CMAKE_PROJECT_NAME@";
const char *PLUGIN_VERSION = "@CMAKE_PROJECT_VERSION@";

void obs_log(int log_level, const char *format, ...)
{
	if (!format)
		return;

	/* "[" + "] " = 3 chars, plus null terminator */
	size_t length = strlen(PLUGIN_NAME) + strlen(format) + 4;

	char *templ = bmalloc(length);
	if (!templ)
		return;

	snprintf(templ, length, "[%s] %s", PLUGIN_NAME, format);

	va_list args;
	va_start(args, format);
	blogva(log_level, templ, args);
	va_end(args);

	bfree(templ);
}
